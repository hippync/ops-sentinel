{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UpdateOnlyTheOrdersService",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:DescribeServices"
      ],
      "Resource": "arn:aws:ecs:REGION:ACCOUNT:service/ops-sentinel-sandbox/orders-api"
    },
    {
      "Sid": "ReadTaskDefinitionHistoryForRollback",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTaskDefinition",
        "ecs:ListTaskDefinitions"
      ],
      "Resource": "*"
    }
  ]
}
