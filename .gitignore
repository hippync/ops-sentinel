# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Java
target/
*.class
!.mvn/wrapper/maven-wrapper.jar

# Terraform — state and real variable values must never be committed
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Secrets
.env
.env.*
!.env.example
*.pem
credentials

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code: the shared harness is committed (see docs/agentic-workflow.md); personal
# overrides and session state are not.
.claude/settings.local.json
.claude/state/

# Maven wrapper: the jar is downloaded by mvnw itself (wrapperUrl in the properties)
.mvn/wrapper/maven-wrapper.jar
