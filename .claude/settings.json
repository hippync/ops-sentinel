{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(agents/.venv/bin/pytest*)",
      "Bash(agents/.venv/bin/ruff*)",
      "Bash(agents/.venv/bin/mypy*)",
      "Bash(agents/.venv/bin/python scripts/check_iam_scope.py*)",
      "Bash(cd agents && .venv/bin/pytest*)",
      "Bash(cd agents && .venv/bin/ruff*)",
      "Bash(cd agents && .venv/bin/mypy*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(cd sandbox-app && ./mvnw*)",
      "Bash(./mvnw*)",
      "Bash(terraform fmt*)",
      "Bash(terraform validate*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/post_edit_checks.py\"",
            "timeout": 180,
            "statusMessage": "Running ruff, mypy, pytest"
          }
        ]
      }
    ]
  }
}
